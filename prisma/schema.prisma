generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  OWNER
  ADMIN
}

enum OwnerApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum ReportTargetType {
  REVIEW
  COMMUNITY
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum OwnerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                  String              @id @db.VarChar(50)
  name                String              @db.VarChar(50)
  email               String              @unique @db.VarChar(100)
  password            String              @db.VarChar(255)
  university          String              @db.VarChar(50)
  isStudentVerified   Boolean?            @default(false)
  role                UserRole            @default(USER)
  ownerApprovalStatus OwnerApprovalStatus @default(NONE)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  reviews             Review[]
  communities         Community[]
  reports             Report[]
  ownerApplications   OwnerApplication[]
  ownedRestaurants    Restaurant[]
}

model Restaurant {
  restaurantId String            @id @db.VarChar(50)
  name         String            @db.VarChar(100)
  description  String?           @db.Text
  imageUrl     String?           @db.VarChar(500)
  latitude     Float?
  longitude    Float?
  avgRating    Float?            @default(0.0)
  category     String?           @db.VarChar(20)
  suitableFor  String?           @db.VarChar(40)
  ownerId      String?           @db.VarChar(50)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  owner        User?             @relation(fields: [ownerId], references: [id])
  reviews      Review[]
  photos       RestaurantPhoto[]
}

model RestaurantPhoto {
  photoId      BigInt     @id @default(autoincrement())
  restaurantId String     @db.VarChar(50)
  photoUrl     String     @db.VarChar(500)
  sortOrder    Int        @default(0)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [restaurantId], onDelete: Cascade)
}

model Review {
  reviewId     String        @id @db.VarChar(50)
  userId       String        @db.VarChar(50)
  restaurantId String        @db.VarChar(50)
  content      String        @db.Text
  rating       Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  user         User          @relation(fields: [userId], references: [id])
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [restaurantId])
  photos       ReviewPhoto[]
  reports      Report[]

  @@index([userId, deletedAt])
}

model ReviewPhoto {
  photoId  BigInt @id @default(autoincrement())
  reviewId String @db.VarChar(50)
  photoUrl String @db.VarChar(255)
  review   Review @relation(fields: [reviewId], references: [reviewId], onDelete: Cascade)
}

model Community {
  postId       String    @id @db.VarChar(50)
  userId       String    @db.VarChar(50)
  title        String    @db.VarChar(255)
  content      String?   @db.Text
  category     String?   @db.VarChar(20)
  targetCount  Int
  currentCount Int       @default(1)
  isClosed     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id])
  reports      Report[]

  @@index([userId, deletedAt])
}

model Report {
  reportId    String           @id @db.VarChar(50)
  reporterId  String           @db.VarChar(50)
  targetType  ReportTargetType
  reviewId    String?          @db.VarChar(50)
  postId      String?          @db.VarChar(50)
  reason      String           @db.VarChar(100)
  detail      String?          @db.Text
  status      ReportStatus     @default(PENDING)
  action      String?          @db.VarChar(50)
  processedAt DateTime?
  createdAt   DateTime         @default(now())
  reporter    User             @relation(fields: [reporterId], references: [id])
  review      Review?          @relation(fields: [reviewId], references: [reviewId])
  post        Community?       @relation(fields: [postId], references: [postId])

  @@index([targetType, status, createdAt])
}

model OwnerApplication {
  applicationId  String                 @id @db.VarChar(50)
  userId         String                 @db.VarChar(50)
  restaurantName String                 @db.VarChar(100)
  businessNumber String?                @db.VarChar(30)
  reason         String?                @db.Text
  status         OwnerApplicationStatus @default(PENDING)
  rejectReason   String?                @db.Text
  reviewedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
}
